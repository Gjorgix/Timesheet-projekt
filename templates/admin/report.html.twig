{% extends 'base.html.twig' %}

{% block title %}Raporty pracowników{% endblock %}

 {% block javascripts %}
     {{ parent() }}
     <script src="{{ asset('js/admin/report.js') }}" type="module"></script>
{% endblock %}

{% block body %}



    <div class="card card-primary card-outline col-12">
        <h1 class="card-header py-3">Raporty pracowników</h1>
        <div class="row">
            <div class="col-3">
                <div class="card-body">
                <form id="generate-raport" method="POST" action="#"  data-turbo="false">

                    <div class="mb-3">
                        <label for="employee_id" class="form-label">Pracownik:</label>
                        <select name="employee_id" id="employee_id" class="form-select">
                            {% for employee in employeesList %}
                                <option value="{{ employee.id }}">
                                    {{ employee.firstName }} {{ employee.lastName }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="from" class="form-label">Data od</label>
                            <input required type="date" id="from" name="from" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="to" class="form-label">Data do</label>
                            <input required type="date" id="to" name="to" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="project" class="form-label">Projekt</label>
                        <select id="project" name="project" class="form-select">
                            <option value="0" selected>Wszystkie projekty</option>
                            {% for project in projects %}
                                <option value="{{ project.id }}">{{ project.name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <button class=" btn btn-outline-primary" name="generate-report-btn" type="submit" >Generuj Raport</button>
                </form>
                </div>
            </div>

            <div id="report-container"></div>
        </div>


    </div>





    <script>
        let path_app_admin_report_ajax = '{{ path('app_admin_report_ajax') }}';
    </script>
{% endblock %}
