{% extends 'base.html.twig' %}

{% block title %}Edytuj użytkownika{% endblock %}

{% block body %}
    <h1>Edytuj użytkownika</h1>

    <form name="user" method="post" action="{{ path('app_user_save') }}">

        <div><label for="user_email" class="required">Email</label><input type="text" id="user_email" name="user_email" required="required" maxlength="180" value="{{ user.email }}" /></div>
        <div><label for="user_firstName" class="required">First name</label><input type="text" id="user_firstName" name="user_firstName" required="required" maxlength="100" value="{{ user.firstName }}" /></div>
        <div><label for="user_lastName" class="required">Last name</label><input type="text" id="user_lastName" name="user_lastName" required="required" maxlength="100" value="{{ user.lastName }}" /></div>

        <div>
            <label for="user_role" class="required">Role</label>
            <select id="user_role" name="user_role">
                <option value="ROLE_USER" {% if 'ROLE_USER' in user.roles %}selected="selected"{% endif %}>Pracownik</option>
                <option value="ROLE_ADMIN" {% if 'ROLE_ADMIN' in user.roles %}selected="selected"{% endif %}>Administrator</option>
            </select>
        </div>
        <div><label for="user_plainPassword">Plain password</label><input type="password" id="user_plainPassword" name="user_plainPassword" /></div>
        <div><label for="user_isActive">Is active</label>
            <input type="checkbox" id="user_isActive" name="user_isActive" value="1" {% if user.isActive %}checked="checked"{% endif %} />
        </div>
        <input type="hidden" name="id" value="{{ user.id }}">
        <button type="submit">Zapisz zmiany</button>

    </form>


    <p>
        <a href="{{ path('app_user_list') }}">Powrót do listy użytkowników</a>
    </p>
{% endblock %}
