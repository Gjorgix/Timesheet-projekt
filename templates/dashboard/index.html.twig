{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
    <h1>Witaj, {{ user.firstName }}!</h1>

    <p>Zalogowano jako: {{ user.email }}</p>

    <p><a href="{{ path('app_time_entry_index')}}">Wpisy</a></p>

    {% if user.roles[0] == "ROLE_ADMIN" %}
        <p><a href="{{path('app_admin')}}">Dashboard admina</a> </p>
    {% endif %}
    <p>
        <a href="{{ path('app_logout') }}">Wyloguj</a>
    </p>
{% endblock %}
