{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
    <h1>Witaj, {{ user.firstName }}!</h1>

    <p>Zalogowano jako: {{ user.email }}</p>

    <p>
        <a href="{{ path('app_time_entry_index') }}">Moje wpisy czasu</a>
    </p>

    {% if is_granted('ROLE_ADMIN') %}
        <p>
            <a href="{{ path('app_admin') }}">Panel administratora</a>
        </p>
    {% endif %}
{% endblock %}
