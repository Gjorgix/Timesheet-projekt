{% extends 'base.html.twig' %}

{% block title %}Edytuj projekt{% endblock %}

{% block body %}
    <h1 class="content-header py-3">Edytuj projekt</h1>

    <div class="card card-primary card-outline col-4">
        <div class="card-body">
            <form id="project_edit_form" method="post" action="{{ path('app_project_save') }}" data-turbo="false">
                <div class="mb-3">
                    <label for="project_name" class="form-label">Nazwa:</label>
                    <input type="text" id="project_name" name="project_name" class="form-control" required="required"
                           maxlength="255" value="{{ project.name }}"/>
                </div>

                <div class="mb-3">
                    <label for="project_description" class="form-label">Opis:</label>
                    <textarea id="project_description" name="project_description" class="form-control" rows="4"
                              maxlength="1024">{{ project.description }}</textarea>
                </div>

                <div class="form-check mb-3">
                    <input type="checkbox" id="project_isActive" name="project_isActive" class="form-check-input" value="1"
                           {% if project.isActive %}checked="checked"{% endif %}/>
                    <label for="project_isActive" class="form-check-label">Aktywny</label>
                </div>

                <input type="hidden" name="id" value="{{ project.id }}">
                <button class="btn btn-primary" type="submit">Zapisz zmiany</button>
            </form>
            <a class="btn btn-outline-secondary mt-2" href="{{ path('app_project_list') }}">Powrót do listy projektów</a>
        </div>
    </div>
{% endblock %}
