{% extends 'base.html.twig' %}

{% block title %}Edytuj projekt{% endblock %}

{% block body %}
    <h1>Edytuj projekt</h1>

    <form id="project_new_form"  method="post" action="{{ path('app_project_edit_update', {id:project.id}) }}" data-turbo="false">

        <div><label for="project_name" class="required">Name</label><input type="text" id="project_name" name="project_name"  required="required" maxlength="255" value="{{ project.name() }}"/></div>
        <div><label for="project_description">Description</label><textarea id="project_description" name="project_description"  >{{ project.description() }}</textarea></div>

        <div><label for="project_isActive">Is active</label><input type="checkbox" id="project_isActive" name="project_isActive" value="1" checked="{{ project.isActive() }}"/></div>

        <button type="submit">Zapisz zmiany</button>
    </form>

    <p>
        <a href="{{ path('app_project_list') }}">Powrót do listy projektów</a>
    </p>
{% endblock %}
