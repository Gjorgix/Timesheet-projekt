{% extends 'base.html.twig' %}

{% block title %}Projekty{% endblock %}

{% block body %}
    <h1>Projekty</h1>

    <p>
        <a href="{{ path('app_admin') }}">Panel administratora</a>
    </p>
    <p>
        <a href="{{ path('app_project_new') }}">Dodaj projekt</a>
    </p>

    <table>
        <thead>
        <tr>
            <th>Nazwa</th>
            <th>Opis</th>
            <th>Status</th>
            <th>Akcje</th>
        </tr>
        </thead>

        <tbody>
        {% for project in projects %}
            <tr>
                <td>{{ project.name }}</td>
                <td>{{ project.description }}</td>
                <td>
                    {% if project.isActive %}
                        Aktywny
                    {% else %}
                        Nieaktywny
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('app_project_edit', {id: project.id}) }}">Edytuj</a>
                    <form method="post"
                    {% if project.isActive %}
                              action="{{ path('app_project_deactivate', {id: project.id}) }}"
                              style="display: inline">
                            <button type="submit">Dezaktywuj</button>
                    {% else %}
                        action="{{ path('app_project_activate', {id: project.id}) }}"
                        style="display: inline">
                        <button type="submit">Aktywuj</button>
                    {% endif %}
                    </form>

                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">Brak projektów.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
