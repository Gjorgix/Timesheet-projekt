<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}{% endblock %}</title>

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('/plugins/bootstrap/bootstrap.min.css') }}">
            <link rel="stylesheet" href="{{ asset('/plugins/adminlte/adminlte.min.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

    </head>
    <body class="bg-body-tertiary">
    <div class="app-wrapper">
        <nav class="app-header navbar navbar-expand bg-body px-2 " >
            <div class="container-fluid ">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}">Home</a></li>
                    {% if app.user %}
                        <li class="nav-item"><a class="nav-link" href="{{ path('app_time_entry_index') }}">Moje wpisy</a></li>

                        {% if is_granted('ROLE_ADMIN') %}
                            <li class="nav-item"><a class="nav-link" href="{{ path('app_admin') }}">Panel administratora</a></li>
                            <li class="nav-item"><a class="nav-link" href="{{ path('app_admin_report') }}">Raporty pracowników</a></li>
                        {% endif %}
                    {% endif %}
                </ul>
                <ul class="navbar-nav ms-auto">
                    {% if app.user %}
                        <li class="nav-item dropdown">
                            <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown" >
                                {{ app.user.firstName }} {{ app.user.lastName }}
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="{{ path('app_user_settings') }}">Ustawienia</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="{{ path('app_logout') }}">Wyloguj</a></li>
                            </ul>
                        </li>
                    {% else %}
                        <li class="nav-item"><a class="nav-link" href="{{ path('app_login') }}">Zaloguj się</a></li>
                    {% endif %}
                </ul>
            </div>
        </nav>
        <main class="app-main">
            <div class="app-content">
                <div class="container-fluid">
                    {% block body %}

                    {% endblock %}
                </div>
            </div>
        </main>

    </div>


    <script src="{{ asset('/plugins/bootstrap/bootstrap.bundle.min.js') }}"></script>
    <script src="{{ asset('/plugins/adminlte/adminlte.min.js') }}"></script>
    </body>
</html>
