
{% extends 'base.html.twig' %}

{% block title %}Strona główna{% endblock %}

{% block body %}
    <h1>Strona główna</h1>

    <p>System zarządzania czasem pracy.</p>

    {% if app.user %}
        <p>
            Witaj, {{ app.user.firstName }}!
        </p>
    {% else %}
        <p>
            <a href="{{ path('app_login') }}">Zaloguj się</a>, aby korzystać z systemu.
        </p>
    {% endif %}
{% endblock %}

