
{% extends 'base.html.twig' %}

{% block title %}Strona główna{% endblock %}

{% block body %}
    <h1>Strona główna</h1>

    <p>System ewidencji czasu pracy.</p>

    {% if app.user %}
        <p>
            Witaj, {{ app.user.firstName }}!
        </p>
    {% else %}
        <p>
            Zaloguj się, aby korzystać z systemu.
        </p>
    {% endif %}
{% endblock %}

