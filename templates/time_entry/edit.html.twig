{% extends 'base.html.twig' %}

{% block title %}Edytuj wpis czasu{% endblock %}

{% block body %}
    <h1>Edytuj wpis czasu</h1>

    <form name="time_entry" method="post" action="{{ path('app_time_entry_save') }}">

    <div>
        <label for="time_entry_project" class="required">Project</label>
        <select id="time_entry_project" name="time_entryProject" required>
            {% for project in projects %}
                <option value="{{ project.id }}"{% if project.id == time_entry.project.id %} selected{% endif %}>{{ project.name }}</option>
            {% endfor %}
        </select>
    </div>
    <div>
        <label for="time_entry_startDate" class="required">Data rozpoczęcia</label>
        <input type="datetime-local" id="time_entry_startDate" name="time_entryStartDate" max="{{ time_entry.endAt|date('Y-m-d\\TH:i') }}"
               required="required" value="{{ time_entry.startAt|date('Y-m-d\\TH:i') }}" />
    </div>
    <div>
        <label for="time_entry_endDate" class="required">Data zakończenia</label>
        <input type="datetime-local" id="time_entry_endDate" name="time_entryEndDate" min="{{ time_entry.startAt|date('Y-m-d\\TH:i') }}"
               required="required" value="{{ time_entry.endAt|date('Y-m-d\\TH:i') }}" />
    </div>
    <div>
        <label for="time_entry_comment">Comment</label>
        <textarea id="time_entry_comment" name="time_entryComment">{{ time_entry.comment }}</textarea>
    </div>

     <input type="hidden" name="id" value="{{ time_entry.id }}">
    <button type="submit">Zapisz zmiany</button>

    </form>

    <p>
        <a href="{{ path('app_time_entry_index') }}">Powrót do wpisów</a>
    </p>

    <script>
        const startDateInput = document.getElementById('time_entry_startDate');
        const endDateInput = document.getElementById('time_entry_endDate');

        function updateDateLimits() {
            startDateInput.max = endDateInput.value;
            endDateInput.min = startDateInput.value;
        }

        startDateInput.addEventListener('change', updateDateLimits);
        endDateInput.addEventListener('change', updateDateLimits);
        updateDateLimits();
    </script>
{% endblock %}
