{% extends 'base.html.twig' %}

{% block title %}Moje wpisy {% endblock %}

 {% block javascripts %}
     {{ parent() }}
     <script src="{{ asset('js/time_entries/index.js') }}" type="module"></script>
 {% endblock %}

{% block body %}


    <div class="card card-primary card-outline ">
        <h1 class="card-header py-3">Wpisy </h1>
        <div class="row">
            <div class=" col-3">
                <div class="card-body">
                    <a class="btn btn-primary mb-3 " href="{{ path('app_time_entry_new') }}">Dodaj wpis</a>

                    <form id="filter-form" method="POST" action="#" data-turbo="false">

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="from" class="form-label">Data od</label>
                                <input required type="date" id="from" name="from" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="to" class="form-label">Data do</label>
                                <input required type="date" id="to" name="to" class="form-control" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="project" class="form-label">Projekt</label>
                            <select id="project" name="project" class="form-select">
                                <option value="0" selected>Wszystkie projekty</option>
                                {% for project in projects %}
                                    <option value="{{ project.id }}">{{ project.name }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        <button class=" btn btn-outline-primary" name="filter-form-btn" type="submit" >Filtruj</button>
                    </form>
                </div>
            </div>

            <div id="result-container"
                 data-ajax-url="{{ path('app_time_entry_index_ajax') }}"
                 data-edit-url-template="{{ path('app_time_entry_edit', {id: 'ID'}) }}">
            </div>
        </div>

    </div>


{% endblock %}
