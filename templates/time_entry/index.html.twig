{% extends 'base.html.twig' %}

{% block title %}Moje wpisy {% endblock %}

 {% block javascripts %}
     {{ parent() }}
     <script src="{{ asset('js/time_entries/index.js') }}" type="module"></script>
 {% endblock %}

{% block body %}
    <h1>Wpisy </h1>

    <p>
        <a href="{{ path('app_time_entry_new') }}">Dodaj wpis</a>
    </p>

    <form id="filter-form" method="POST" action="#"  data-turbo="false">

        <div><label for="from">Data od</label><input type="date" id="from" name="from" /></div>
        <div><label for="to">Data do</label><input type="date" id="to" name="to" /></div>
        <div><label for="limit">Ilość wpisów</label><input type="number" id="limit" name="limit" /></div>

        <button name="filter-form-btn" type="submit" >Filtruj</button>
    </form>

    <div id="result-container"
         data-ajax-url="{{ path('app_time_entry_index_ajax') }}"
         data-edit-url-template="{{ path('app_time_entry_edit', {id: 'ID'}) }}">
    </div>


    <p>
        <a href="{{ path('app_dashboard') }}">Dashboard</a>
    </p>

{% endblock %}
