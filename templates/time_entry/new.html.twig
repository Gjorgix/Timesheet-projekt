{% extends 'base.html.twig' %}

{% block title %}Dodaj wpis czasu{% endblock %}

{% block body %}
    <h1>Dodaj wpis czasu</h1>

    {{ form_start(form) }}

    {{ form_row(form.project) }}
    {{ form_row(form.startAt) }}
    {{ form_row(form.endAt) }}
    {{ form_row(form.comment) }}

    <button type="submit">Zapisz wpis</button>

    {{ form_end(form) }}

    <p>
        <a href="{{ path('app_dashboard') }}">Powrót do dashboardu</a>
    </p>
{% endblock %}
