{% extends 'base.html.twig' %}

{% block title %}Dodaj wpis {% endblock %}

{% block body %}
    <h1>Dodaj wpis </h1>

    {% for message in app.flashes('error') %}
        <p>{{ message }}</p>
    {% endfor %}

    {% set now = 'now'|date %}
    <form name="time_entry" method="post" action="{{ path('app_time_entry_save') }}" data-turbo="false">
        <div>
            <label for="time_entry_project" class="required">Projekt</label>
            <select id="time_entry_project" name="time_entryProject" required>
                <option value="" disabled selected>Wybierz projekt</option>
                {% for project in projects %}
                    <option value="{{ project.id }}">{{ project.name }}</option>
                {% endfor %}
            </select>
        </div>

{#        Wykorzystac biblioteke datepicker, bootstarp i adminlte, jquery validation #}
        <div>
            <label for="time_entry_startDate" class="required">Data rozpoczęcia</label>
            <input type="datetime-local" id="time_entry_startDate" name="time_entryStartDate" required value="{{ now|date('Y-m-d') }}" />
        </div>
        <div>
            <label for="time_entry_endDate" class="required">Data zakończenia</label>
            <input type="datetime-local" id="time_entry_endDate" name="time_entryEndDate" required value="{{ now|date('Y-m-d') }}" />
        </div>
        <div>
            <label for="time_entry_comment">Komentarz</label><textarea id="time_entry_comment" name="time_entryComment"></textarea>
        </div>

        <button type="submit">Zapisz wpis</button>
    </form>

    <p>
        <a href="{{ path('app_time_entry_index') }}">Powrót do listy wpisów</a>
    </p>

{% endblock %}
